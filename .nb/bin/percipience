def cmd_context(args):
    action = args.context_action
    if action == "export":
        modules = [m.strip() for m in args.module.split(",")] if getattr(args, "module", None) else None
        res = TerminalAgentASTProxy.export_context(
            workspace_root=REPO_ROOT,
            format_type=args.format,
            target_modules=modules
        )
        if args.output:
            out_p = Path(args.output)
            if not out_p.is_absolute():
                out_p = REPO_ROOT / out_p
            out_p.parent.mkdir(parents=True, exist_ok=True)
            out_p.write_text(res["payload"], encoding="utf-8")
            print(f"✅ Exported AST context to {out_p} ({res['tokens_saved']:,} tokens saved, {res['reduction_pct']}% reduction)")
        else:
            print(res["payload"])

