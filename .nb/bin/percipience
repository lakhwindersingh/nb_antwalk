    # tools
    p_tools = subparsers.add_parser("tools", help="Audit platform tools exposure and encryption governance")
    p_tools.add_argument("tools_action", nargs="?", default="status", choices=["status"], help="Tools action")
    p_tools.set_defaults(func=cmd_tools)

    # package
    p_pkg = subparsers.add_parser("package", help="Package config, executables, scripts, and core engines per commercial pricing tier")
    p_pkg.add_argument("--tier", default="free", choices=["free", "team", "business", "enterprise", "plan_free", "plan_team", "plan_business", "plan_enterprise"])
    p_pkg.add_argument("--output", help="Output package directory")
    p_pkg.add_argument("--tenant", default="tenant_community_default", help="Tenant ID for license signing")
    p_pkg.set_defaults(func=cmd_package)

    # provision
    p_prov = subparsers.add_parser("provision", help="Provision runtime bundles and permissions across IntelliJ, VSCode, and SaaS Portal")
    p_prov.add_argument("--tenant", required=True, help="Tenant ID")
    p_prov.add_argument("--tier", default="free", choices=["free", "team", "business", "enterprise", "plan_free", "plan_team", "plan_business", "plan_enterprise"])
    p_prov.add_argument("--target", default="all", choices=["all", "intellij", "vscode", "portal"])
    p_prov.set_defaults(func=cmd_provision)

    # permission
    p_perm = subparsers.add_parser("permission", help="Verify feature entitlements and RBAC permissions")
    p_perm_subs = p_perm.add_subparsers(dest="permission_action", required=True)
    p_perm_chk = p_perm_subs.add_parser("check", help="Check permission for a specific feature")
    p_perm_chk.add_argument("--tenant", help="Tenant ID")
    p_perm_chk.add_argument("--tier", choices=["free", "team", "business", "enterprise", "plan_free", "plan_team", "plan_business", "plan_enterprise"], help="Tier ID")
