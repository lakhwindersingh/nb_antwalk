def cmd_tokens(args):
    action = args.tokens_action
    if action == "status":
        cfg = TokenOptimizationConfig.load_config(REPO_ROOT).get("token_optimization", {})
        ledger = TokenTracker.load_ledger(REPO_ROOT)
        s = ledger.get("summary", {})
        print("⚡ Percipience Token Optimization & FinOps Status:")
        print(f"   Master Status: {'ENABLED' if cfg.get('enabled') else 'DISABLED'}")
        print(f"   Intensity Mode: {cfg.get('mode', 'standard')}")
        print("   Active Strategies:")
        for strat, val in cfg.get("strategies", {}).items():
            icon = "✓" if (val and cfg.get('enabled')) else "✗"
            print(f"     [{icon}] {strat}: {'ON' if val else 'OFF'}")
        print("\n📊 Cumulative Metering Summary:")
        print(f"   Total Events Tracked: {s.get('total_events', 0):,}")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} ({s.get('average_reduction_pct', 0.0):.1f}% avg reduction)")
        print(f"   Gross Spend Saved: ${s.get('total_gross_savings_usd', 0.0):.4f} USD")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f} USD")
        print(f"   Net Customer Cash Saved: ${s.get('total_net_savings_usd', 0.0):.4f} USD")

    elif action == "enable":
        TokenOptimizationConfig.set_enabled(True, REPO_ROOT)
        print("✅ Token optimization enabled globally for workspace and CI/CD pipelines.")

    elif action == "disable":
        TokenOptimizationConfig.set_enabled(False, REPO_ROOT)
        print("⏸️  Token optimization disabled. All context payloads will pass through uncompressed.")

    elif action == "set-mode":
        TokenOptimizationConfig.set_mode(args.mode, REPO_ROOT)
        print(f"✅ Token optimization intensity preset updated to: '{args.mode}'.")

    elif action == "set-strategy":
        enabled = (args.state.lower() in ["on", "true", "1", "enable", "enabled"])
        TokenOptimizationConfig.set_strategy(args.strategy, enabled, REPO_ROOT)
        state_str = "ENABLED" if enabled else "DISABLED"
        print(f"✅ Strategy '{args.strategy}' is now {state_str}.")

    elif action == "optimize":
        file_path = Path(args.file)
        if not file_path.exists():
            print(f"❌ File not found: {args.file}")
            sys.exit(1)
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        ext = file_path.suffix.lstrip(".")
        type_map = {"py": "python", "ts": "typescript", "js": "javascript", "go": "go", "rs": "rust", "md": "markdown", "yaml": "yaml", "yml": "yaml", "json": "json", "log": "log", "diff": "diff"}
        ctype = type_map.get(ext, "python")
        mode = getattr(args, "mode", None)
        pruned, stats = UnifiedTokenOptimizer.optimize_content(content, ctype, REPO_ROOT, override_mode=mode)
        print(f"⚡ Token Optimization Results for: {file_path.name} ({ctype}):")
        print(f"   Status: {stats.get('status', 'OPTIMIZED')}")
        print(f"   Baseline Tokens: {stats.get('uncompressed_tokens', 0):,}")
        print(f"   Pruned Tokens: {stats.get('pruned_tokens', 0):,}")
        print(f"   Net Tokens Saved: {stats.get('saved_tokens', 0):,} ({stats.get('reduction_pct', stats.get('reduction_percentage', 0.0))}% reduction)")

    elif action == "track":
        file_path = Path(args.file)
        if not file_path.exists():
            print(f"❌ File not found: {args.file}")
            sys.exit(1)
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        ext = file_path.suffix.lstrip(".")
        lang = "typescript" if ext in ["ts", "js"] else ("python" if ext == "py" else ext)
        _, stats = ASTOptimizer.prune_source(content, lang)
        try:
            rel_path = str(file_path.resolve().relative_to(REPO_ROOT.resolve()))
        except Exception:
            rel_path = str(file_path)
        evt = TokenTracker.record_event(
            repo_root=REPO_ROOT,
            file_path=rel_path,
            uncompressed_tokens=stats["uncompressed_tokens"],
            pruned_tokens=stats["pruned_tokens"],
            session_or_pr=args.pr or "manual_cli",
            model_id=args.model or "claude-3-5-sonnet-20241022"
        )
        print(f"✅ Token savings captured for: {rel_path}")
        print(f"   Uncompressed: {evt['uncompressed_tokens']:,} tokens | Pruned: {evt['pruned_tokens']:,} tokens")
        print(f"   Saved: {evt['tokens_saved']:,} tokens ({evt['reduction_percentage']}%)")
        print(f"   Gross Savings: ${evt['gross_savings_usd']:.5f} | Net Client Savings: ${evt['net_savings_usd']:.5f}")

    elif action == "scan":
        target = args.dir if args.dir else "workplace"
        print(f"⚡ Scanning repository directory '{target}' for AST token compression...")
        res = TokenTracker.scan_and_track_repo(
            repo_root=REPO_ROOT,
            target_dir=target,
            session_or_pr=args.pr or "ci_scan",
            model_id=args.model or "claude-3-5-sonnet-20241022"
        )
        s = res["summary"]
        print(f"✅ AST Pruning Scan Complete: {res['new_events_count']} files logged to ledger.")
        print(f"   Total Uncompressed: {s.get('total_uncompressed_tokens', 0):,} tokens")
        print(f"   Total Pruned: {s.get('total_pruned_tokens', 0):,} tokens")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} tokens ({s.get('average_reduction_pct', 0.0):.1f}% reduction)")
        print(f"   Gross Dollar Savings: ${s.get('total_gross_savings_usd', 0.0):.4f}")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f}")
        print(f"   Net Client Savings: ${s.get('total_net_savings_usd', 0.0):.4f}")

    elif action == "summary":
        ledger = TokenTracker.load_ledger(REPO_ROOT)
        s = ledger.get("summary", {})
        print("📊 Percipience Token Savings & Metering Summary:")
        print(f"   Events Tracked: {s.get('total_events', 0):,}")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} tokens ({s.get('average_reduction_pct', 0.0):.1f}% avg reduction)")
        print(f"   Gross Financial Savings: ${s.get('total_gross_savings_usd', 0.0):.4f} USD")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f} USD")
        print(f"   Net Customer Cash Saved: ${s.get('total_net_savings_usd', 0.0):.4f} USD")
        print(f"   Ledger: .nb/context/ledger/token_savings_ledger.yaml")

    elif action == "report":
        out_path = Path(args.output) if args.output else None
        TokenTracker.generate_markdown_report(REPO_ROOT)
        dest = out_path or (REPO_ROOT / "workplace/docs/reports/token_savings_report.md")
        print(f"✅ Token savings scorecard emitted to: {dest}")

def cmd_cicd(args):
    action = args.action or "run"
    if action == "run":
        print("🤖 Running Autonomous CI/CD Pipeline (Self-Sustaining, Self-Recovering, Self-Improving)...")
        res = AutonomousCICDOrchestrator.run_autonomous_pipeline(
            repo_root=REPO_ROOT,
            auto_heal=not args.no_heal,
            optimize=not args.no_optimize
        )
        print(f"   [1/4] Self-Sustaining Housekeeping: Reclaimed {res['stages']['sustain']['reclaimed_leases']} leases, Merkle intact: {res['stages']['sustain']['merkle_continuous']}")
        print(f"   [2/4] Self-Healing: {res['stages']['heal'].get('status', 'OK')}")
        print(f"   [3/4] Self-Improving Feedback Loop: Avg reduction: {res['stages']['improve']['current_avg_reduction_pct']:.1f}%")
        print(f"✅ Autonomous CI/CD Pipeline Run Complete: {res['run_id']} (Sealed Merkle Block: {res['stages']['merkle_seal']['block_id']})")
    elif action == "heal":
        print(f"🩹 Triggering Autonomous Self-Healing on module: {args.target_module}...")
        res = AutonomousHealer.diagnose_and_heal(REPO_ROOT, target_module=args.target_module)
        print(f"   Action: {res['action_taken']}")
        print(f"   Attempts: {res['attempts']}")
        print(f"   Merkle Block Sealed: {res.get('merkle_block')}")
        print("✅ Self-Healing routine completed.")
    elif action == "sustain":
        print("🧹 Executing Self-Sustaining Housekeeping Pass...")
        res = SelfSustainingEngine.execute_maintenance(REPO_ROOT)
        print(f"   Reclaimed Leases: {res['reclaimed_leases']}")
        print(f"   Cleaned Artifacts: {res['cleaned_artifacts']}")
        print(f"   Merkle Continuous: {res['merkle_continuous']}")
        print("✅ Workspace self-sustaining pass completed.")
    elif action == "optimize":
        print("🧠 Running Self-Improving Telemetry Analysis...")
        res = SelfImprovingEngine.analyze_and_optimize(REPO_ROOT)
        print(f"   Current Reduction: {res['current_avg_reduction_pct']:.1f}%")
        print("✅ Self-improving ledger updated: context/ledger/self_improving_ledger.yaml")

def cmd_layer(args):
    action = args.layer_action
    if action == "pack":
        if not check_basic_tools_permission():
            print("❌ Access Denied: Basic platform tools exposure and user plan packaging/encryption (.nbpack) are disabled on Free Community Tier.")
            print("   Free tier user plans remain strictly plaintext (non-encryptable).")
            print("   Use plaintext plans directly with '.nb/bin/percipience layer apply --plan <path>'.")
            sys.exit(1)
        plan_path = Path(args.plan)
        if not plan_path.is_absolute():
            plan_path = REPO_ROOT / plan_path
        if not plan_path.exists():
            print(f"❌ Plan file not found: {plan_path}")
            sys.exit(1)
        out_path = Path(args.output) if args.output else (REPO_ROOT / ".nb" / "bundles" / f"{plan_path.stem}.nbpack")
        if not out_path.is_absolute():
            out_path = REPO_ROOT / out_path
        spaces = [s.strip() for s in args.include_spaces.split(",")] if args.include_spaces else None
        print(f"📦 Compiling encrypted .nbpack layer from: {plan_path.name}")
        res = NBPackEnvelope.compile_layer_pack(REPO_ROOT, plan_path, out_path, include_spaces=spaces)
        print(f"✅ Sealed domain layer bundle created at: {res}")
        print(f"   Bundle Size: {res.stat().st_size} bytes")

    elif action == "apply":
        if args.pack:
            pack_path = Path(args.pack)
            if not pack_path.is_absolute():
                pack_path = REPO_ROOT / pack_path
            if not pack_path.exists():
                print(f"❌ Layer pack not found: {pack_path}")
                sys.exit(1)
            in_memory = not args.write_disk
            print(f"⚡ Consuming encrypted .nbpack domain layer: {pack_path.name}")
            res = NBPackEnvelope.apply_layer_pack(REPO_ROOT, pack_path, in_memory=in_memory)
            print(f"✅ Layer '{res['layer_id']}' applied successfully!")
            print(f"   Mode: {res['storage_mode']}")
            print(f"   Components Mounted: {res['components_loaded']}")
            print(f"   Merkle Block Sealed: {res['merkle_block_id']} ({res['merkle_block_hash'][:16]}...)")
        elif args.plan:
            plan_path = Path(args.plan)
            if not plan_path.is_absolute():
                plan_path = REPO_ROOT / plan_path
            if not plan_path.exists():
                print(f"❌ Plan file not found: {plan_path}")
                sys.exit(1)
            print(f"⚡ Applying plaintext domain layer: {plan_path.name}")
            block = MerkleEngine.seal_block(REPO_ROOT, action=f"LAYER_APPLIED:{plan_path.stem}")
            print(f"✅ Layer '{plan_path.stem}' applied successfully!")
            print(f"   Merkle Block Sealed: {block['block_id']}")

    elif action == "wrap":
        wrapped = TerminalAgentASTProxy.wrap_terminal_agent(
            agent_cmd=args.agent,
            agent_args=[],
            workspace_root=REPO_ROOT,
            format_type=getattr(args, "format", None)
        )
        print(f"✅ Terminal agent '{args.agent}' wrapped with AST compression:")
        print(f"   Session ID: {wrapped['session_id']}")
        print(f"   Context File: {wrapped['context_file']}")
        print(f"   Tokens Saved: {wrapped['tokens_saved']:,} ({wrapped['reduction_pct']}% savings)")
        print(f"   Injected Env: {list(wrapped['env'].keys())}")

    elif action == "list":
        ledger_path = (REPO_ROOT / ".nb" / "context" / "ledger" / "context_ledger.yaml" if (REPO_ROOT / ".nb" / "context").exists() else REPO_ROOT / "context" / "ledger" / "context_ledger.yaml")
        applied = []
        if ledger_path.exists():
            try:
                import yaml
                with open(ledger_path, "r", encoding="utf-8") as f:
                    data = yaml.safe_load(f) or {}
                    applied = data.get("applied_layers", [])
            except Exception:
                pass
        mounted = NBPackEnvelope.list_mounted_layers()
        print(f"📋 Registered Domain Layers ({len(applied)} recorded in ledger, {len(mounted)} mounted in RAM):")
        for layer in applied:
            print(f"   • {layer.get('layer_id')} [{layer.get('storage_mode')}] - SHA: {layer.get('bundle_sha256', '')[:12]}...")

    elif action in ("remove", "rollback"):
        layer_id = getattr(args, "layer", "") or getattr(args, "pack", "")
        if not layer_id:
            print("❌ Layer ID or pack path required for removal.")
            sys.exit(1)
        print(f"🔄 Rolling back setup for layer: {layer_id}...")
        res = NBPackEnvelope.remove_layer_pack(REPO_ROOT, layer_id)
        print(f"✅ Layer '{res['layer_id']}' rolled back with zero disk residue.")
        print(f"   Evicted from RAM: {res['evicted_from_ram']}")
        print(f"   Removed from Ledger: {res['removed_from_ledger']}")
        if res.get('merkle_block_id'):
            print(f"   Merkle Block Sealed: {res['merkle_block_id']}")


def cmd_drift(args):
    action = args.drift_action
    if action == "check":
        print("🔍 Evaluating 6-Vector Semantic Parity & Workspace Drift...")
        rep = SemanticParityEngine.compute_parity_report(REPO_ROOT)
        print(f"   Composite S_SP Score: {rep['composite_s_sp']:.4f} ({rep['classification']})")
        print(f"   Status Color: {rep['color']}")
        print(f"   Action: {rep['action_required']}")
        if rep['composite_s_sp'] >= 0.95:
            print("✅ Parity verified. Workspace is zero-drift and PR-merge ready.")
        elif rep['composite_s_sp'] >= 0.85:
            print("⚠️ Parity score in amber zone. Dual-reconciliation loop recommended.")
        else:
            print("⛔ Critical drift detected! Immediate rollback required.")
            sys.exit(1)

    elif action == "report":
        print("📊 Comprehensive 6-Vector Semantic Parity Breakdown:")
        rep = SemanticParityEngine.compute_parity_report(REPO_ROOT)
        print(f"   Composite S_SP: {rep['composite_s_sp']:.4f} [{rep['classification']}]")
        print("   --------------------------------------------------------")
        for vec, data in rep["vector_scores"].items():
            print(f"   • {vec.replace('_', ' ').title():<22}: Score = {data['score']:.2f} (Weight = {data['weight']:.2f})")
        print("   --------------------------------------------------------")
        print(f"   Action: {rep['action_required']}")

    elif action == "reconcile":
        mode = args.mode
        module_id = args.module or "mod_portal_marketing"
        if mode == "revert":
            symbols = [s.strip() for s in (args.symbols or "unprompted_helper,dead_abstract_fn").split(",")]
            print(f"🔄 Executing Automated Revert Mode on '{module_id}' for symbols: {symbols}...")
            res = DualReconciliationEngine.reconcile_revert(REPO_ROOT, module_id, symbols)
            print(f"✅ Revert diff synthesized in {res['execution_time_ms']}ms with {res['sibling_impact_pct']}% sibling impact.")
            print("--- Unified Reverse Diff ---")
            print(res["reverse_diff"])
        elif mode == "evolve":
            title = args.title or "Additive API Contract Evolution"
            desc = args.desc or "Subagent discovered necessary schema extension for rate-limiting."
            print(f"📝 Drafting RFC Specification Delta in user/hitl/proposed_spec_delta.md...")
            res = DualReconciliationEngine.reconcile_evolve(
                workspace_root=REPO_ROOT,
                module_id=module_id,
                title=title,
                description=desc,
                proposed_fields=[{"name": "rate_limit_rpm", "type": "integer", "description": "Requests per minute"}]
            )
            print(f"✅ Spec delta RFC '{res['delta_id']}' drafted successfully at {res['file_path']}.")
            print(f"   Awaiting Human-in-the-Loop review and approval.")

    elif action == "approve-delta":
        delta_id = args.delta_id or "DELTA_LATEST"
        print(f"✍️ Approving RFC Specification Delta: {delta_id}...")
        res = DualReconciliationEngine.approve_delta(REPO_ROOT, delta_id)
        print(f"✅ {res['message']}")

