        )
        print(f"✅ Request formalized successfully!")
        print(f"   Request ID: {res['request_id']}")
        print(f"   Title: {res['title']}")
        print(f"   Format Type: {res['format_type']}")
        print(f"   Target Module: {res['target_module']}")
        print(f"   Captured At: {res['relative_file_path']}")
        print(f"   SHA-256: {res['content_sha256'][:16]}...")

        if args.run_workflow:
            print(f"🚀 Running formalized request through derivation workflow: {args.workflow}...")
            wf_res = RequestFormalizerEngine.run_through_workflow(
                formal_file_path=res['formal_file_path'],
                workflow_name=args.workflow,
                workspace_root=REPO_ROOT
            )
            print(f"✅ Derivation workflow execution completed!")
            print(f"   Workflow: {wf_res['workflow']}")
            print(f"   Merkle Block Sealed: {wf_res['merkle_block_id']} ({wf_res['merkle_block_hash'][:16]}...)")
            print(f"   Ledger Updated: context/ledger/context_ledger.yaml")
    except Exception as e:
        print(f"❌ Formalization failed: {e}")
        sys.exit(1)

